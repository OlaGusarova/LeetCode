#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Running pre-commit checks..."

# Проверка типов для всего проекта (быстро)
echo "📝 Type checking..."
npm run type-check || exit 1

# Проверка линтинга и тестов для измененных файлов
echo "🔧 Linting and testing staged files..."
npx lint-staged || exit 1

echo "✅ All checks passed!"