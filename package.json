{
  "name": "LeetCode",
  "version": "1.0.0",
  "description": "LeetCode solutions in TypeScript",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:staged": "jest --findRelatedTests --bail --passWithNoTests",
    "new": "ts-node --transpile-only scripts/generate-template.ts",
    "stats": "ts-node scripts/stats.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint 'solutions/**/*.ts'",
    "lint:fix": "eslint 'solutions/**/*.ts' --fix",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "30.0.0",
    "@types/node": "25.6.0",
    "@typescript-eslint/eslint-plugin": "8.59.2",
    "@typescript-eslint/parser": "8.59.2",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jest": "29.0.0",
    "lint-staged": "17.0.5",
    "ts-jest": "29.4.9",
    "ts-node": "10.9.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.59.4"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "npm run test:staged"
    ]
  }
}
